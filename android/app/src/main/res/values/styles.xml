<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <!-- manual: Google Play pre-launch report 2026-08-20 flagged deprecated
         Window.setStatusBarColor/setNavigationBarColor usage, unsupported on Android 15+.
         windowOptOutEdgeToEdgeEnforcement never worked anyway (targetSdk 36 has no opt-out —
         see CLAUDE.md §8.5), and the explicit statusBarColor below is what made
         AppCompat/RN fall back to those deprecated setters. Dropping both is a no-op on real
         Android 15/16 behavior (edge-to-edge was already enforced) and removes the deprecated
         call. No app.json equivalent exists for this native theme attribute. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <!-- manual: REL-6 fix 2026-08-12. AppTheme had no windowBackground, so it fell back to
         AppCompat's default light-theme white — visible as a white flash for the instant
         between the (correctly red) splash screen hiding and RN's first paint. Matching the
         splash background here closes that gap. No app.json equivalent exists for this
         Activity-level windowBackground; app.json's splash.backgroundColor (#EE1B24) already
         matches. -->
    <item name="android:windowBackground">@color/splashscreen_background</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
  </style>
</resources>