rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && userId == uid();
      allow delete: if false;
    }

    match /emailIndex/{emailLower} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == uid();
      allow delete: if false;
    }

    match /connections/{connId} {
      function isParticipant() {
        return isSignedIn() &&
          (uid() == resource.data.fromUid || uid() == resource.data.toUid);
      }
      allow get, list: if isParticipant();
      allow create: if isSignedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.toUid != uid();
      allow update: if isParticipant();
      allow delete: if false;
    }

    match /characterSheets/{sheetId} {
      function isOwner() {
        return isSignedIn() && (
          resource.data.ownerUid == uid() ||
          (resource.data.owners != null && uid() in resource.data.owners)
        );
      }
      function isEditor() {
        return isSignedIn() && (
          isOwner() ||
          (resource.data.editors != null && uid() in resource.data.editors)
        );
      }
      allow get, list: if isEditor();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.owners != null
        && uid() in request.resource.data.owners;
      allow update: if isOwner()
        || ( isEditor()
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.owners == resource.data.owners
             && request.resource.data.editors == resource.data.editors );
      allow delete: if isOwner();
    }
  }
}
