rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /users/{userId} {
      // SEC-1: single-doc get is self-only (no code path reads another user by id).
      // list stays open (getEditorsForSheet queries where('uid','in',chunk), chunk <= 10)
      // but capped so a plain unfiltered .get() can no longer dump the whole collection.
      allow get: if isSignedIn() && userId == uid();
      allow list: if isSignedIn() && request.query.limit <= 10;
      allow create, update: if isSignedIn() && userId == uid();
      allow delete: if isSignedIn() && userId == uid();
    }

    match /emailIndex/{emailLower} {
      // SEC-2: create only into an empty slot; update only if you already owned this
      // entry. Closes the emailIndex/{victim} hijack (attacker overwriting uid).
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && resource == null;
      allow update: if isSignedIn()
        && request.resource.data.uid == uid()
        && resource.data.uid == uid();
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }

    match /connections/{connId} {
      function isParticipant() {
        return isSignedIn() &&
          (uid() == resource.data.fromUid || uid() == resource.data.toUid);
      }
      allow get, list: if isParticipant();
      allow create: if isSignedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.toUid != uid();
      // SEC-4: fromUid/toUid are immutable after create.
      allow update: if isParticipant()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if false;
    }

    match /characterSheets/{sheetId} {
      function isOwner() {
        return isSignedIn() && (
          resource.data.ownerUid == uid() ||
          (resource.data.owners != null && uid() in resource.data.owners)
        );
      }
      function isEditor() {
        return isSignedIn() && (
          isOwner() ||
          (resource.data.editors != null && uid() in resource.data.editors)
        );
      }
      // SEC-3 / COL-8: minimal shape guard — required keys, critical field types,
      // and generous length/size caps. Deliberately NOT a full schema (would go
      // stale and start rejecting legitimate client writes) and deliberately does
      // NOT cap changeHistory (P2.1 already made arrayUnion writes unbounded on
      // purpose; trimming is read-side, a separate COL-9 task).
      function isValidCharacterSheetWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'ownerUid', 'owners', 'editors', 'name', 'class', 'race'])
          && d.id is string
          && d.ownerUid is string
          && d.owners is list && d.owners.size() > 0
          && d.editors is list
          && d.name is string && d.name.size() <= 200
          && d.class is string && d.class.size() <= 100
          && d.race is string && d.race.size() <= 100
          && (!('inventory' in d) || (d.inventory is list && d.inventory.size() <= 500))
          && (!('weapons' in d) || (d.weapons is list && d.weapons.size() <= 100))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 20000))
          && (!('backstory' in d) || (d.backstory is string && d.backstory.size() <= 20000));
      }
      // resource == null lets a client check "does this id exist yet" (the create-vs-update
      // check every upsert does) without permission-denied: reading resource.data on a
      // nonexistent doc always evaluates false, so the plain isEditor() check used to deny
      // this even for the doc's future owner, before the doc could ever be created. Safe:
      // there is no data behind a nonexistent id, and isEditor() still fully gates docs that
      // do exist.
      allow get, list: if resource == null || isEditor();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.owners != null
        && uid() in request.resource.data.owners
        && isValidCharacterSheetWrite();
      allow update: if ( isOwner()
        || ( isEditor()
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.owners == resource.data.owners
             && request.resource.data.editors == resource.data.editors ) )
        && isValidCharacterSheetWrite();
      allow delete: if isOwner();

      // COL-9: append-only change-log subcollection, one doc per (uid, tab, atMs) entry
      // instead of the arrayUnion'd changeHistory[] field above (which stays unbounded/
      // deprecated but is no longer written to by the client, see characterCloudRepository.ts).
      // COL-6: presence subcollection, one doc per active viewer uid, heartbeat-refreshed.
      // Both cross-reference the parent sheet doc via get() (same mechanic as
      // dmCampaignInitiative's campaignDoc() below), since `resource.data` inside a nested
      // match refers to the subcollection doc, not the parent.
      function parentSheet() {
        return get(/databases/$(database)/documents/characterSheets/$(sheetId)).data;
      }
      function isSheetOwnerOf(doc) {
        return isSignedIn() && (doc.ownerUid == uid() || (doc.owners != null && uid() in doc.owners));
      }
      function isSheetEditorOf(doc) {
        return isSignedIn() && (isSheetOwnerOf(doc) || (doc.editors != null && uid() in doc.editors));
      }

      match /changes/{entryId} {
        function isValidChangeEntryWrite() {
          let d = request.resource.data;
          return d.keys().hasAll(['id', 'uid', 'tab', 'paths', 'atMs', 'createdAt'])
            && d.id == entryId
            && d.uid is string && d.uid == uid()
            && d.tab in ['Overview', 'Combat', 'Magic', 'Inventory', 'Notes', 'Homebrew']
            && d.paths is list && d.paths.size() > 0 && d.paths.size() <= 50
            && (!('actorRole' in d) || d.actorRole in ['DM', 'Player'])
            && (!('summary' in d) || (d.summary is string && d.summary.size() <= 500))
            && d.atMs is int
            && d.createdAt is timestamp;
        }

        allow get, list: if isSheetEditorOf(parentSheet());
        allow create: if isSheetEditorOf(parentSheet()) && isValidChangeEntryWrite();
        // Append-only ledger: nobody, including the sheet owner, can edit or erase a
        // history entry once written.
        allow update, delete: if false;
      }

      match /presence/{presenceUid} {
        function isValidPresenceWrite() {
          let d = request.resource.data;
          return d.keys().hasAll(['uid', 'tab', 'lastActiveAt'])
            && d.uid == presenceUid && d.uid == uid()
            && d.tab in ['Overview', 'Combat', 'Magic', 'Inventory', 'Notes', 'Homebrew']
            && (!('actorRole' in d) || d.actorRole in ['DM', 'Player'])
            && d.lastActiveAt is timestamp;
        }

        allow get, list: if isSheetEditorOf(parentSheet());
        // Only your own uid's presence doc, and only while you still have sheet access.
        allow create, update: if isSignedIn() && presenceUid == uid()
          && isSheetEditorOf(parentSheet()) && isValidPresenceWrite();
        // Self-cleanup always allowed, even after access to the sheet was revoked, so a
        // removed editor's stale presence doc doesn't linger forever.
        allow delete: if isSignedIn() && presenceUid == uid();
      }
    }

    match /dmCampaigns/{campaignId} {
      function isCampaignOwner() {
        return isSignedIn() && (
          resource.data.ownerUid == uid() ||
          (resource.data.owners != null && uid() in resource.data.owners)
        );
      }
      function isCampaignEditor() {
        return isSignedIn() && (
          isCampaignOwner() ||
          (resource.data.editors != null && uid() in resource.data.editors)
        );
      }
      // SEC-3 / COL-8: see isValidCharacterSheetWrite() above for the same rationale.
      function isValidDmCampaignWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'ownerUid', 'owners', 'editors', 'name'])
          && d.id is string
          && d.ownerUid is string
          && d.owners is list && d.owners.size() > 0
          && d.editors is list
          && d.name is string && d.name.size() <= 200;
      }

      allow get, list: if isCampaignEditor();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.owners != null
        && uid() in request.resource.data.owners
        && isValidDmCampaignWrite();
      allow update: if ( isCampaignOwner()
        || ( isCampaignEditor()
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.owners == resource.data.owners
             && request.resource.data.editors == resource.data.editors ) )
        && isValidDmCampaignWrite();
      allow delete: if isCampaignOwner();
    }

    match /dmCampaignInvites/{code} {
      // Capability-style invite codes for campaign membership — deliberately NOT the
      // emailIndex pattern (SEC-2): no email->uid trust hop, and list:false means codes
      // can't be enumerated. Redemption (adding the redeemer to dmCampaigns.editors) is
      // NOT done here — a non-member cannot self-add per the dmCampaigns update rule
      // above, so redemption goes through the redeemCampaignInvite Cloud Function (Admin
      // SDK, bypasses these rules). These rules only gate direct client access/writes.
      function isValidDmCampaignInviteWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'campaignId', 'role', 'createdByUid', 'createdAtMs', 'expiresAtMs', 'usedByUids'])
          && d.id == code
          && d.campaignId is string
          && d.role == 'editor'
          && d.createdByUid is string
          && d.createdAtMs is int
          && d.expiresAtMs is int
          && d.usedByUids is list;
      }

      // Any signed-in user may read a specific invite by its exact (random, unguessable)
      // code — this is the capability check. list stays disabled so codes can't be
      // enumerated by querying the collection.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == uid()
        && get(/databases/$(database)/documents/dmCampaigns/$(request.resource.data.campaignId)).data.owners.hasAny([uid()])
        && isValidDmCampaignInviteWrite();
      // All mutation after creation (marking a code as used, expiring it) happens via
      // redeemCampaignInvite (Admin SDK). No revoke/delete path yet — a client-side
      // update/delete here would let anyone self-add to usedByUids or erase a code.
      allow update, delete: if false;
    }

    match /dmCampaignNotes/{noteId} {
      function isNoteOwner() {
        return isSignedIn() && (
          resource.data.ownerUid == uid() ||
          (resource.data.owners != null && uid() in resource.data.owners)
        );
      }
      function isNoteEditor() {
        return isSignedIn() && (
          isNoteOwner() ||
          (resource.data.editors != null && uid() in resource.data.editors)
        );
      }
      // SEC-3 / COL-8: see isValidCharacterSheetWrite() above for the same rationale.
      function isValidDmCampaignNoteWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'ownerUid', 'owners', 'editors', 'campaignId', 'title'])
          && d.id is string
          && d.ownerUid is string
          && d.owners is list && d.owners.size() > 0
          && d.editors is list
          && d.campaignId is string
          && d.title is string && d.title.size() <= 200
          && (!('content' in d) || (d.content is string && d.content.size() <= 20000))
          && (!('kind' in d) || d.kind in ['note', 'session', 'loot']);
      }

      allow get, list: if isNoteEditor();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.owners != null
        && uid() in request.resource.data.owners
        && isValidDmCampaignNoteWrite();
      allow update: if ( isNoteOwner()
        || ( isNoteEditor()
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.owners == resource.data.owners
             && request.resource.data.editors == resource.data.editors ) )
        && isValidDmCampaignNoteWrite();
      allow delete: if isNoteOwner();
    }

    match /dmCampaignEncounters/{encounterId} {
      function isEncounterOwner() {
        return isSignedIn() && (
          resource.data.ownerUid == uid() ||
          (resource.data.owners != null && uid() in resource.data.owners)
        );
      }
      function isEncounterEditor() {
        return isSignedIn() && (
          isEncounterOwner() ||
          (resource.data.editors != null && uid() in resource.data.editors)
        );
      }
      // SEC-3 / COL-8: see isValidCharacterSheetWrite() above for the same rationale.
      // COL-9: label/players/monsters capped so a single encounter record cannot approach
      // the 1 MiB Firestore document limit (same risk class as campaignNote title/content).
      function isValidDmCampaignEncounterWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'ownerUid', 'owners', 'editors', 'campaignId', 'label'])
          && d.id is string
          && d.ownerUid is string
          && d.owners is list && d.owners.size() > 0
          && d.editors is list
          && d.campaignId is string
          && d.label is string && d.label.size() <= 200
          && (!('players' in d) || (d.players is list && d.players.size() <= 30))
          && (!('monsters' in d) || (d.monsters is list && d.monsters.size() <= 30));
      }

      allow get, list: if isEncounterEditor();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.owners != null
        && uid() in request.resource.data.owners
        && isValidDmCampaignEncounterWrite();
      allow update: if ( isEncounterOwner()
        || ( isEncounterEditor()
             && request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.owners == resource.data.owners
             && request.resource.data.editors == resource.data.editors ) )
        && isValidDmCampaignEncounterWrite();
      allow delete: if isEncounterOwner();
    }

    match /dmCampaignInitiative/{campaignId} {
      // Single active tracker per campaign, doc id === campaignId. Unlike the collections
      // above, this doc does NOT carry its own owners/editors array — it cross-references
      // dmCampaigns/{campaignId} directly (same get() precedent as dmCampaignInvites above),
      // so a player added to the campaign later is instantly visible here with no resync.
      function campaignDoc() {
        return get(/databases/$(database)/documents/dmCampaigns/$(campaignId)).data;
      }
      function isCampaignOwnerOf(doc) {
        return isSignedIn() && doc.owners != null && uid() in doc.owners;
      }
      function isCampaignEditorOf(doc) {
        return isSignedIn() && (isCampaignOwnerOf(doc) || (doc.editors != null && uid() in doc.editors));
      }

      // SEC-3 / COL-8 style shape guard; COL-9 style cap on combatants.
      function isValidDmCampaignInitiativeWrite() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'campaignId', 'ownerUid', 'round', 'combatants', 'updatedAtMs'])
          && d.id == campaignId
          && d.campaignId == campaignId
          && d.ownerUid is string
          && d.round is int && d.round >= 0
          && d.combatants is list && d.combatants.size() <= 40
          && d.updatedAtMs is int;
      }

      // Every current owner/editor of the parent campaign may read the live tracker —
      // the app itself renders a read-only view for non-owners, but the requirement is
      // that all campaign members can see the active encounter.
      allow get: if isSignedIn() && isCampaignEditorOf(campaignDoc());
      // doc id === campaignId is always fetched directly; no query pattern exists, so
      // list stays closed (same no-enumeration posture as dmCampaignInvites above).
      allow list: if false;

      // Only the campaign OWNER (the GM) may write — editors get read-only access here,
      // unlike dmCampaignNotes/dmCampaignEncounters where editors can also write content.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && isCampaignOwnerOf(campaignDoc())
        && isValidDmCampaignInitiativeWrite();
      allow update: if isSignedIn()
        && isCampaignOwnerOf(campaignDoc())
        && request.resource.data.campaignId == resource.data.campaignId
        && isValidDmCampaignInitiativeWrite();
      allow delete: if isSignedIn() && isCampaignOwnerOf(campaignDoc());
    }
  }
}
