{
  "expo": {
    "name": "Mythgate 5e Companion",
    "slug": "DnDCharacter",
    "scheme": "mythgatednd",
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false
        }
      ]
    ],
    "version": "1.0.6",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6d4ab658-1bc9-48a0-8c86-eeffa8f2a85e",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EE1B24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vind.MythgateDND"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EE1B24"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.vind.MythgateDND",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "mythgatednd.pp.ua", "pathPrefix": "/join" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6d4ab658-1bc9-48a0-8c86-eeffa8f2a85e"
      }
    },
    "owner": "vindener"
  }
}
