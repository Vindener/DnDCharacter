{
  "name": "mythgate-5e-companion",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint:theme": "node scripts/lint-theme.mjs",
    "lint:ui": "node scripts/lint-ui-tokens.mjs",
    "lint": "eslint --ext .ts,.tsx,.js src App.tsx index.js",
    "validate": "npm run typecheck && npm run lint && npm run lint:theme",
    "validate:srd": "tsx scripts/validate-srd.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rules": "firebase emulators:exec --project mythgatednd --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "profile:manual:dev-client:android": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/manual-dev-client-android.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/auth": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native-firebase/functions": "^23.8.8",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/material-top-tabs": "^7.4.28",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/stack": "^7.9.3",
    "events": "^3.3.0",
    "expo": "~54.0.35",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-localization": "~17.0.9",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "i18next": "^26.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-material-menu": "^2.0.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.0.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.24.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [],
        "listUnknownPackages": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "tar": "7.5.21",
    "shell-quote": "1.9.0",
    "undici": "6.27.0",
    "fast-uri": "3.1.4",
    "protobufjs": "7.6.5",
    "brace-expansion": "5.0.8",
    "ws": "7.5.11",
    "@expo/cli": {
      "ws": "8.21.0"
    },
    "react-native": {
      "ws": "6.2.4",
      "react-devtools-core": {
        "ws": "7.5.11"
      }
    },
    "@react-native/dev-middleware": {
      "ws": "6.2.4"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.0"
    }
  },
  "private": true
}
