    },
    {
      "id": "file:src/shared/helpers/sync/conflictPolicy.ts",
      "type": "file",
      "name": "conflictPolicy.ts",
      "filePath": "src/shared/helpers/sync/conflictPolicy.ts",
      "summary": "Політика вирішення конфліктів синхронізації персонажа — визначає, до якої секції аркуша належить шлях, чи є він критичним, і які шляхи конфліктують між локальною та хмарною версією.",
      "tags": ["policy", "collaborative-editing", "conflict-resolution"],
      "complexity": "moderate",
      "languageNotes": "Функція pathToSyncSection визначає гранулярність merge (CLAUDE.md §5.5): секція combat об'єднує hp/ac/initiative/conditions/weapons, тому зміна HP і додавання condition різними редакторами конфліктують на рівні всієї секції, а не окремого поля."
    },
