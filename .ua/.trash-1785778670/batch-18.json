    },
    {
      "id": "document:.agents/MEMORY.md",
      "type": "document",
      "name": "MEMORY.md",
      "filePath": ".agents/MEMORY.md",
      "summary": "Стабільна пам'ять репозиторію для агента: технологічний стек (React Native/Expo/Zustand/Firebase), поточний продуктовий напрям, факти про спільне редагування персонажів кількома людьми, перелік архітектурно ключових файлів та наявні інструменти валідації.",
      "tags": ["документація", "пам'ять-агента", "архітектура", "collaborative-editing", "codex"],
      "complexity": "simple"
    },
    {
      "id": "document:.agents/REPO_MAP.md",
      "type": "document",
      "name": "REPO_MAP.md",
      "filePath": ".agents/REPO_MAP.md",
      "summary": "Карта репозиторію для агента: структура директорій src/ (навігація, екрани, спільні компоненти, стори, сервіси), поточні напрямки роботи (Dice, Home, Character, Spellbook, Bestiary), ключові користувацькі потоки та файли з високим впливом на систему.",
      "tags": ["документація", "карта-репозиторію", "навігація-по-коду", "архітектура", "codex"],
      "complexity": "simple"
    },
    {
      "id": "document:.agents/TOOLS.md",
      "type": "document",
      "name": "TOOLS.md",
      "filePath": ".agents/TOOLS.md",
      "summary": "Політика використання інструментів для Codex: правила пакетного менеджера npm, надійні команди проєкту (typecheck/lint/test), стратегія валідації, команди інспекції репозиторію та обережність із закоміченим android/ і версіями (versionName у build.gradle).",
      "tags": ["документація", "тулінг", "npm", "валідація", "android"],
      "complexity": "simple"
    },
    {
      "id": "document:.agents/USER.md",
      "type": "document",
      "name": "USER.md",
      "filePath": ".agents/USER.md",
      "summary": "Преференції користувача щодо співпраці з Codex: стиль спілкування українською з прямими практичними порадами, формат представлення результатів і продуктові пріоритети (Android UX, безпечний інкрементальний прогрес).",
      "tags": ["документація", "преференції-користувача", "комунікація", "застаріла-інформація", "codex"],
      "complexity": "simple",
      "languageNotes": "Розділ «Current Product Preference» досі перелічує застарілий порядок спринтів (Dice Roller → Skeleton-loader → Home → ...), що вже не узгоджується з поточним фокусом на release hardening, описаним у CLAUDE.md."
    },
    {
      "id": "config:.agents/openai.yaml",
      "type": "config",
      "name": "openai.yaml",
      "filePath": ".agents/openai.yaml",
      "summary": "YAML-конфігурація Codex-агента для OpenAI-сумісного інтерфейсу: опис агента, поведінкові інструкції (session-first UX, Play/Edit розділення), контекст проєкту (мова, тип кодової бази, платформа) та перелік основних і допоміжних файлів інструкцій з .agents/.",
      "tags": ["конфігурація", "codex", "yaml", "агентна-конфігурація", "openai"],
      "complexity": "simple",
      "languageNotes": "Файл містить дублікат ключа `instructions` на верхньому рівні YAML-документа (рядки 12 і 31) — специфічний парсер зазнав невдачі через недопустимий дублікат ключа мапи й перейшов у regex-фолбек для екстракції секцій."
    }
  ],
